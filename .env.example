# Copy to .env for local development. Never commit the real .env file.

# Local dev uses SQLite. On Railway, set DATABASE_URL from the Postgres add-on
# (postgresql+psycopg2://user:pass@host:port/dbname).
DATABASE_URL=sqlite:///./nasa_trends.db

LOG_LEVEL=INFO

# NASA POWER needs no API key. These control politeness toward the service.
POWER_BASE_URL=https://power.larc.nasa.gov
POWER_MAX_REQUESTS_PER_MINUTE=30
POWER_TIMEOUT_SECONDS=60
POWER_MAX_RETRIES=3
CACHE_TTL_HOURS=168

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
